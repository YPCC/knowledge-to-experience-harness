# Knowledge-to-Experience Harness — LLM Backend Configuration
# Copy this file to .env and fill in the values you need.
# NEVER commit a real .env file. Add .env to .gitignore.

# ---------------------------------------------------------------------------
# Choose one primary provider (or configure multiple and select at runtime)
# ---------------------------------------------------------------------------

# Option 1: Gemini API (Google AI Studio / Generative Language API)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# or the older name some libraries still accept:
# GOOGLE_API_KEY=

# Option 2: Grok / xAI API
# Get a key at https://console.x.ai/
XAI_API_KEY=
# some tools also accept:
# GROK_API_KEY=

# Option 3: Vertex AI (Gemini on Google Cloud) using Application Default Credentials (ADC)
# No API key required. Credentials come from:
#   - gcloud auth application-default login   (local development)
#   - GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON (CI / servers)
#   - Workload Identity / attached service account (when running on GCP)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Set to true when you want the Google Gen AI SDK to target Vertex AI instead of the Gemini API
GOOGLE_GENAI_USE_VERTEXAI=true
# Optional: path to a service-account key file (leave empty to use ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------
# Optional model overrides (leave empty to use sensible defaults)
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash
# GROK_MODEL=grok-4
# VERTEX_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Other harness settings (optional)
# ---------------------------------------------------------------------------
# Default provider when multiple are configured: gemini | grok | vertex
K2E_DEFAULT_LLM_PROVIDER=grok
